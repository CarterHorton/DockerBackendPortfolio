# Copy to .env and fill in. .env is never committed.

# Signs the login session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# true in production (site is served over HTTPS). Needs the proxy to send
# X-Forwarded-Proto, see README "Authentication". Leave false for local testing.
COOKIE_SECURE=false

# Let visitors create accounts (role "user"; they can't change site content)
ALLOW_REGISTRATION=false

# Optional: which proxies to trust for the visitor's IP / HTTPS.
# Default trusts private-network proxies (nginx, cloudflared on the same machine).
# TRUST_PROXY=loopback, linklocal, uniquelocal
